<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/rid_guard_content_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.68" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rid_guard_controls_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintBottom_toTopOf="@id/rid_guard_content_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rid_guard_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rid_guard_title"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/rid_guard_state_badge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/rid_guard_idle_badge" />
            </LinearLayout>

            <TextView
                android:id="@+id/rid_guard_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/rid_guard_status_default"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rid_guard_device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#0F000000"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:text="@string/rid_guard_device_check_placeholder"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/rid_guard_transports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/rid_guard_transports_default" />

            <TextView
                android:id="@+id/rid_guard_last_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rid_guard_last_scan_idle" />

            <TextView
                android:id="@+id/rid_guard_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#18B91C1C"
                android:padding="8dp"
                android:textColor="#B91C1C"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rid_guard_button_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/rid_guard_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rid_guard_start" />

                <Button
                    android:id="@+id/rid_guard_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/rid_guard_stop" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rid_guard_button_row_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/rid_guard_silence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rid_guard_silence" />

                <Button
                    android:id="@+id/rid_guard_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/rid_guard_settings" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rid_guard_button_row_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/rid_guard_permissions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rid_guard_permissions" />

                <Button
                    android:id="@+id/rid_guard_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/rid_guard_battery" />
            </LinearLayout>

            <org.opendroneid.android.ridguard.RidGuardRadarView
                android:id="@+id/rid_guard_radar"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp" />

            <FrameLayout
                android:id="@+id/rid_guard_map_area"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp">

                <FrameLayout
                    android:id="@+id/rid_guard_map_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rid_guard_map_disabled"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/rid_guard_map_disabled"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/rid_guard_detected_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#10000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/rid_guard_detected_drones"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rid_guard_content_split" />

    <FrameLayout
        android:id="@+id/rid_guard_list_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rid_guard_detected_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
